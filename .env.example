NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://mikka:mikka@localhost:5432/mikka?schema=public"
# DATABASE_URL="postgresql://postgres:1234@localhost:5432/mikka?schema=public"
# Mail provider — leave empty for now. MailModule falls back to a console
# provider (logs emails instead of sending) whenever MAIL_HOST is unset.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=

# Used to build links inside verification/reset emails (web page or app deep link).
FRONTEND_URL=http://localhost:3000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Leave empty until a real Google OAuth client is created.
GOOGLE_CLIENT_ID=12

# Required by Nominatim's usage policy — must identify the app (+ contact info).
NOMINATIM_USER_AGENT=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Leave empty until a real Supabase project is created.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

CHECK_IN_MAX_DISTANCE_METERS=200
CHECK_IN_COOLDOWN_MINUTES=15