generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
  moduleFormat    = "cjs"
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model BlockedUser {
  id                               String   @id
  blockerId                        String
  blockedId                        String
  createdAt                        DateTime @default(now())
  User_BlockedUser_blockedIdToUser User     @relation("BlockedUser_blockedIdToUser", fields: [blockedId], references: [id])
  User_BlockedUser_blockerIdToUser User     @relation("BlockedUser_blockerIdToUser", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
}

model Booking {
  id         String        @id
  packageId  String
  pilgrimId  String
  status     BookingStatus @default(PENDING)
  totalPrice Float
  paidAmount Float         @default(0)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime
  Package    Package       @relation(fields: [packageId], references: [id])
  User       User          @relation(fields: [pilgrimId], references: [id])
  Payment    Payment?
}

model Company {
  id          String    @id
  userId      String    @unique
  companyName String
  licenseUrl  String
  phone       String?
  address     String?
  isVerified  Boolean   @default(false)
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id])
  Package     Package[]
  Review      Review[]
}

model Doctor {
  id            String          @id
  userId        String          @unique
  specialty     String
  licenseUrl    String?
  isVerified    Boolean         @default(false)
  isAvailable   Boolean         @default(true)
  rating        Float           @default(0)
  reviewCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  User          User            @relation(fields: [userId], references: [id])
  DoctorOrder   DoctorOrder[]
  DoctorReview  DoctorReview[]
  DoctorService DoctorService[]
}

model DoctorMessage {
  id          String      @id
  orderId     String
  senderId    String
  content     String
  createdAt   DateTime    @default(now())
  DoctorOrder DoctorOrder @relation(fields: [orderId], references: [id])
}

model DoctorOrder {
  id            String            @id
  serviceId     String
  pilgrimId     String
  doctorId      String
  status        DoctorOrderStatus @default(PENDING)
  totalPrice    Float
  symptomsNote  String?
  scheduledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime
  DoctorMessage DoctorMessage[]
  Doctor        Doctor            @relation(fields: [doctorId], references: [id])
  User          User              @relation(fields: [pilgrimId], references: [id])
  DoctorService DoctorService     @relation(fields: [serviceId], references: [id])
  DoctorReview  DoctorReview?
}

model DoctorReview {
  id          String      @id
  orderId     String      @unique
  pilgrimId   String
  doctorId    String
  stars       Int
  comment     String?
  createdAt   DateTime    @default(now())
  Doctor      Doctor      @relation(fields: [doctorId], references: [id])
  DoctorOrder DoctorOrder @relation(fields: [orderId], references: [id])
}

model DoctorService {
  id              String        @id
  doctorId        String
  title           String
  description     String?
  price           Float
  durationMinutes Int           @default(30)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  DoctorOrder     DoctorOrder[]
  Doctor          Doctor        @relation(fields: [doctorId], references: [id])
}

model Document {
  id         String   @id
  userId     String
  type       String
  fileUrl    String
  uploadedBy String
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])
}

model Driver {
  id              String            @id
  userId          String            @unique
  vehicleType     VehicleType
  vehicleModel    String
  vehiclePlate    String
  licenseUrl      String?
  isVerified      Boolean           @default(false)
  isAvailable     Boolean           @default(true)
  rating          Float             @default(0)
  reviewCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  User            User              @relation(fields: [userId], references: [id])
  TransportOrder  TransportOrder[]
  TransportReview TransportReview[]
  TransportRoute  TransportRoute[]
}

model Group {
  id            String          @id
  name          String
  packageId     String
  guideId       String
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  User          User            @relation(fields: [guideId], references: [id])
  Package       Package         @relation(fields: [packageId], references: [id])
  GroupLocation GroupLocation[]
  GroupMember   GroupMember[]
  GroupMessage  GroupMessage[]
}

model GroupLocation {
  id        String   @id
  groupId   String
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())
  Group     Group    @relation(fields: [groupId], references: [id])
}

model GroupMember {
  id        String   @id
  groupId   String
  pilgrimId String
  createdAt DateTime @default(now())
  Group     Group    @relation(fields: [groupId], references: [id])
  User      User     @relation(fields: [pilgrimId], references: [id])

  @@unique([groupId, pilgrimId])
}

model GroupMessage {
  id        String   @id
  groupId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  Group     Group    @relation(fields: [groupId], references: [id])
}

model Notification {
  id        String   @id
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model OtpCode {
  id        String   @id
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
}

model Package {
  id              String      @id
  companyId       String
  title           String
  description     String?
  type            PackageType @default(UMRA)
  price           Float
  depositAmount   Float?
  departureDate   DateTime
  returnDate      DateTime?
  durationDays    Int
  hotelName       String?
  hotelStars      Int?
  distanceToHaram Int?
  flightType      String?
  maxPilgrims     Int         @default(50)
  imageUrls       String[]
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  Booking         Booking[]
  Group           Group[]
  Company         Company     @relation(fields: [companyId], references: [id])
}

model Payment {
  id            String    @id
  bookingId     String    @unique
  provider      String
  transactionId String?
  amount        Float
  status        String    @default("pending")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  Booking       Booking   @relation(fields: [bookingId], references: [id])
}

model Report {
  id                               String      @id
  reporterId                       String
  reportedUserId                   String
  context                          ChatContext
  contextId                        String?
  messageId                        String?
  reason                           String
  status                           String      @default("PENDING")
  createdAt                        DateTime    @default(now())
  User_Report_reportedUserIdToUser User        @relation("Report_reportedUserIdToUser", fields: [reportedUserId], references: [id])
  User_Report_reporterIdToUser     User        @relation("Report_reporterIdToUser", fields: [reporterId], references: [id])
}

model Review {
  id        String   @id
  pilgrimId String
  companyId String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Company   Company  @relation(fields: [companyId], references: [id])
  User      User     @relation(fields: [pilgrimId], references: [id])

  @@unique([pilgrimId, companyId])
}

model TelegramLink {
  id        String   @id
  phone     String   @unique
  chatId    String
  createdAt DateTime @default(now())
}

model TransportMessage {
  id             String         @id
  orderId        String
  senderId       String
  content        String
  createdAt      DateTime       @default(now())
  TransportOrder TransportOrder @relation(fields: [orderId], references: [id])
}

model TransportOrder {
  id               String               @id
  routeId          String
  pilgrimId        String
  driverId         String
  seats            Int
  status           TransportOrderStatus @default(PENDING)
  totalPrice       Float
  pickupNote       String?
  scheduledAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  TransportMessage TransportMessage[]
  Driver           Driver               @relation(fields: [driverId], references: [id])
  User             User                 @relation(fields: [pilgrimId], references: [id])
  TransportRoute   TransportRoute       @relation(fields: [routeId], references: [id])
  TransportReview  TransportReview?
}

model TransportReview {
  id             String         @id
  orderId        String         @unique
  pilgrimId      String
  driverId       String
  stars          Int
  comment        String?
  createdAt      DateTime       @default(now())
  Driver         Driver         @relation(fields: [driverId], references: [id])
  TransportOrder TransportOrder @relation(fields: [orderId], references: [id])
}

model TransportRoute {
  id             String           @id
  driverId       String
  fromCity       String
  toCity         String
  vehicleType    VehicleType
  pricePerSeat   Float
  totalSeats     Int
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  TransportOrder TransportOrder[]
  Driver         Driver           @relation(fields: [driverId], references: [id])
}

model User {
  id                                      String           @id
  phone                                   String?          @unique
  email                                   String?          @unique
  password                                String?
  role                                    Role             @default(PILGRIM)
  fullName                                String
  fcmToken                                String?
  isActive                                Boolean          @default(true)
  createdAt                               DateTime         @default(now())
  updatedAt                               DateTime
  googleId                                String?          @unique
  avatar                                  String?
  appleId                                 String?          @unique
  BlockedUser_BlockedUser_blockedIdToUser BlockedUser[]    @relation("BlockedUser_blockedIdToUser")
  BlockedUser_BlockedUser_blockerIdToUser BlockedUser[]    @relation("BlockedUser_blockerIdToUser")
  Booking                                 Booking[]
  Company                                 Company?
  Doctor                                  Doctor?
  DoctorOrder                             DoctorOrder[]
  Document                                Document[]
  Driver                                  Driver?
  Group                                   Group[]
  GroupMember                             GroupMember[]
  Notification                            Notification[]
  OtpCode                                 OtpCode[]
  Report_Report_reportedUserIdToUser      Report[]         @relation("Report_reportedUserIdToUser")
  Report_Report_reporterIdToUser          Report[]         @relation("Report_reporterIdToUser")
  Review                                  Review[]
  TransportOrder                          TransportOrder[]
}

enum BookingStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum ChatContext {
  GROUP
  TRANSPORT
  DOCTOR
}

enum DoctorOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PackageType {
  HAJ
  UMRA
}

enum Role {
  SUPERADMIN
  COMPANY
  GUIDE
  PILGRIM
  DRIVER
  DOCTOR
}

enum TransportOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleType {
  SEDAN
  MINIVAN
  BUS
}
