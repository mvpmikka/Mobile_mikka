NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://mikka:mikka@localhost:5432/mikka?schema=public"
# DATABASE_URL="postgresql://postgres:1234@localhost:5432/mikka?schema=public"
# Mail provider — leave empty for now. MailModule falls back to a console
# provider (logs emails instead of sending) whenever neither BREVO_API_KEY
# nor MAIL_HOST is set.
#
# Brevo (HTTPS API) is preferred over SMTP — Render blocks outbound SMTP
# ports, so MAIL_HOST/MAIL_PORT/etc. only work on hosts that allow them
# (e.g. local dev). Get a key at app.brevo.com > SMTP & API > API Keys, and
# verify MAIL_FROM's address as a sender in Brevo first (Senders, Domains
# & Dedicated IPs > Senders) or sends will be rejected.
BREVO_API_KEY=
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=

# Used to build links inside verification/reset emails (web page or app deep link).
FRONTEND_URL=http://localhost:3000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# Leave empty until a real Google OAuth client is created.
GOOGLE_CLIENT_ID=12

# Required by Nominatim's usage policy — must identify the app (+ contact info).
NOMINATIM_USER_AGENT=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Leave empty until a real Supabase project is created.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

CHECK_IN_MAX_DISTANCE_METERS=200
CHECK_IN_COOLDOWN_MINUTES=15

# Comma-separated emails. Whoever registers/logs in with one of these
# emails is automatically promoted to that role — no manual DB edit needed.
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=

# coturn TURN server — leave empty until it's provisioned. Without it,
# calls only work when both devices can connect via STUN alone (same
# network / no restrictive NAT); TurnCredentialService falls back to a
# STUN-only ICE server list rather than the app failing to boot.
# TURN_SHARED_SECRET must match coturn's static-auth-secret (use-auth-secret mode).
TURN_HOST=
TURN_PORT=3478
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Push wake-up for incoming calls when the callee's app has no live socket
# (backgrounded/closed). Both leave-empty-to-disable, same as MAIL_* above.
# Android — paste the full Firebase service account JSON as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# iOS — APNs Auth Key (.p8), PushKit/VoIP push.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Paste the .p8 file contents, with \n in place of real newlines.
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false