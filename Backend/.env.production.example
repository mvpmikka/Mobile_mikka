NODE_ENV=
PORT=

DATABASE_URL=

# Mail provider — leave empty for now. MailModule falls back to a console
# provider (logs emails instead of sending) whenever MAIL_HOST is unset.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=


# Used to build links inside verification/reset emails. Points at this
# backend itself — it serves a small HTML bridge page (GET /auth/verify-email,
# GET /auth/reset-password) that redirects into the app via mikka:// deep link,
# since Gmail won't linkify custom URL schemes directly.
FRONTEND_URL=

# Dev-only secret — generate a new one for staging/production, never reuse this.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN_DAYS=

EMAIL_VERIFICATION_EXPIRES_IN_HOURS=
PASSWORD_RESET_EXPIRES_IN_MINUTES=

# Leave empty until a real Google OAuth client is created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Required by Nominatim's usage policy — must identify the app (+ contact info).
NOMINATIM_USER_AGENT=
NOMINATIM_BASE_URL=



CHECK_IN_MAX_DISTANCE_METERS=
CHECK_IN_COOLDOWN_MINUTES=
BREVO_API_KEY=

# File storage (server disk)
PUBLIC_BASE_URL=
STORAGE_DIR=/app/storage
